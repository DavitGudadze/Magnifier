SECRET_KEY=any-random-string

# ─── BACKEND_URL ────────────────────────────────────────────────────────────
# This is the ONLY value you must change between local and server.
#
# LOCAL development (default):
#   Backend runs via `python wsgi.py` → listens on port 5000
BACKEND_URL=http://127.0.0.1:5000
#
# SERVER deployment:
#   Backend runs via uWSGI → public traffic goes through bioworkflow.sock,
#   but the frontend must reach it internally via the http-socket on port 5001
#   (set in bioworkflow.ini: http-socket = 127.0.0.1:5001).
#   Comment the line above and uncomment the one below before deploying:
# BACKEND_URL=http://127.0.0.1:5001
# ────────────────────────────────────────────────────────────────────────────

# Leave empty locally. On server: /magnifier
PREFIX=

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local:  http://127.0.0.1:8080/auth/google/callback
# Server: https://formacio.bq.ub.edu/magnifier/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback
