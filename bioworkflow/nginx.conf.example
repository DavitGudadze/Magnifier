# Nginx configuration for Bioinformatics Workflow Platform
#
# Installation:
# 1. Copy this file to /etc/nginx/sites-available/bioworkflow
# 2. Create symlink: sudo ln -s /etc/nginx/sites-available/bioworkflow /etc/nginx/sites-enabled/
# 3. Test config: sudo nginx -t
# 4. Reload: sudo systemctl reload nginx

upstream bioworkflow_app {
    # Gunicorn server
    server 127.0.0.1:8000 fail_timeout=0;
}

# Redirect HTTP to HTTPS (optional, for production with SSL)
# server {
#     listen 80;
#     server_name your-domain.com www.your-domain.com;
#     return 301 https://$server_name$request_uri;
# }

server {
    listen 80;
    # listen 443 ssl http2;  # Enable for HTTPS
    
    server_name your-domain.com www.your-domain.com;
    
    # SSL Configuration (uncomment for HTTPS)
    # ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_ciphers HIGH:!aNULL:!MD5;
    # ssl_prefer_server_ciphers on;
    
    # Maximum upload size (match Flask MAX_CONTENT_LENGTH)
    client_max_body_size 5G;
    client_body_timeout 300s;
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    
    # Logging
    access_log /var/log/nginx/bioworkflow_access.log;
    error_log /var/log/nginx/bioworkflow_error.log warn;
    
    # Root location
    location / {
        # Pass to Gunicorn
        proxy_pass http://bioworkflow_app;
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts for long-running requests
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        
        # Don't buffer uploads
        proxy_request_buffering off;
        
        # Redirect on error
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_redirect off;
    }
    
    # Static files (if you add a frontend later)
    # location /static {
    #     alias /path/to/bioworkflow/static;
    #     expires 30d;
    #     add_header Cache-Control "public, immutable";
    # }
    
    # Health check endpoint
    location /health {
        access_log off;
        proxy_pass http://bioworkflow_app;
        proxy_set_header Host $host;
    }
    
    # Deny access to sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    location ~ ~$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}
