# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a strong random value for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

FLASK_ENV=development        # development | production | testing

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no additional setup required):
DATABASE_URL=sqlite:///bioworkflow.db

# MySQL (production example — uncomment and fill in your credentials):
# DATABASE_URL=mysql+pymysql://youruser:yourpassword@localhost:3306/bioworkflow

# ── Server deployment ─────────────────────────────────────────────────────────
# Leave empty for local development.
# On a shared server set this to the sub-path the proxy assigns, e.g. /bioworkflow
PREFIX=

# ── File uploads ──────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=5368709120   # 5 GB in bytes

# ── Pipeline ─────────────────────────────────────────────────────────────────
PYTHON_INTERPRETER=python3      # point to conda env or full path if needed
TASK_TIME_LIMIT=7200            # seconds before a pipeline run times out

# ── Security ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=False     # set True in production (HTTPS only)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
