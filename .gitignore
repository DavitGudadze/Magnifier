.env
*.env.local
*.env.*.local
secrets.json

# ── Databases ─────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Flask / uWSGI ─────────────────────────────────────────────────────────────
instance/
*.sock
nohup.out

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Build / distribution ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Test & coverage artefacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc

# ── Type-checker caches ───────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Storage / uploaded files (runtime data, not source) ───────────────────────
bioworkflow/storage/
bioworkflow/results*/
bioworkflow/transport*/
bioworkflow/app*/
# (the directory symlinks with special chars from the original server)

# ── Migrations auto-generated artefacts ──────────────────────────────────────
# Keep migrations/ tracked; only ignore generated __pycache__ inside it
bioworkflow/migrations/__pycache__/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
